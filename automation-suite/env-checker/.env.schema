# Example deploy schema. Format: NAME=required|optional[:regex]  # comment
DATABASE_URL=required:^postgres://     # primary database connection string
API_KEY=required                        # third-party API key
PORT=optional:^\d+$                     # web port, digits only
DEBUG=optional:^(true|false)$           # feature flag
LOG_LEVEL=optional:^(DEBUG|INFO|WARN|ERROR)$
